# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=dk

# Base URL of the storefront (used for generating absolute URLs, sitemap, OG tags)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key — activates card/wallet payment on checkout
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development

# PostHog — cookieless product analytics + session replay (free tier is
# generous). Get a key at posthog.com, project settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error monitoring. Get a DSN at sentry.io, project settings →
# Client Keys (DSN). Set the SAME dsn value in both of these (one is used
# server-side, one client-side — Next.js only exposes NEXT_PUBLIC_ vars to
# the browser bundle, hence the duplicate).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: needed for Sentry's source-map upload during build, not for
# error capture itself. Sentry dashboard → org/project settings.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Judge.me — product review widget. Judge.me admin → Settings → Advanced →
# "Enable platform-independent widgets" → paste the generated script URL.
# Note: products still need to exist in Judge.me's system (via their API or
# CSV import) for reviews to actually show — this only renders the widget.
NEXT_PUBLIC_JUDGEME_WIDGET_SCRIPT_URL=

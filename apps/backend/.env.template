STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# If DATABASE_URL is also exported in your shell (e.g. via .zshrc/.bashrc),
# that value silently wins over this file (dotenv does not override existing
# env vars), so the server can end up pointed at a different DB than you expect.
# Run `echo $DATABASE_URL` before debugging auth/data issues to check for this.
DATABASE_URL=
DB_NAME=medusa-backend

# Email (Resend) — leave empty in dev to write emails to .medusa/emails/ instead
RESEND_API_KEY=
RESEND_FROM_EMAIL="Shoppen <onboarding@resend.dev>"

# Printify (print-on-demand) — token from Printify → My Profile → Connections → API tokens
PRINTIFY_API_TOKEN=
# Optional: pin a specific Printify shop (otherwise the first shop is used)
PRINTIFY_SHOP_ID=
# "true" = paid orders go straight to production; default = created as drafts for review
PRINTIFY_AUTO_PRODUCTION=false
# Currency your Printify "Edit price" values are entered in — the sync
# script converts to every other store currency at the live rate
PRINTIFY_PRICE_CURRENCY=usd
# Round converted prices to the nearest .99 charm price. "false" = keep
# exact FX-converted amounts instead
PRINTIFY_PSYCHOLOGICAL_ROUNDING=true

# Stripe payments — activates automatically when set; then run:
#   npx medusa exec ./src/scripts/enable-stripe.ts
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the storefront (used in transactional email links)
STOREFRONT_URL=http://localhost:8000

# Sentry — error monitoring. Get a DSN at sentry.io (a separate project from
# the storefront's is recommended, so backend/frontend errors don't mix).
SENTRY_DSN=

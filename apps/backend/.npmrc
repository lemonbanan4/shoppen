# The npm registry intermittently returns 429 during CI installs, which fails
# the deploy outright. npm's defaults give up after 2 retries within ~60s; be
# considerably more patient so throttling is ridden out instead of fatal.
#
# This must live inside the service directory: Railway builds with
# rootDirectory=/apps/<service>, so only that folder is copied into the build
# context and a repo-root .npmrc is never seen by `npm install`.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-retry-factor=2
